{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$lookup": {
        "from": "customers",
        "localField": "customer_id",
        "foreignField": "_id",
        "as": "c"
      }
    },
    {
      "$unwind": "$c"
    },
    {
      "$match": {
        "$expr": {
          "$gt": [
            {
              "$subtract": [
                "$total",
                "$discount"
              ]
            },
            "$c.age"
          ]
        }
      }
    },
    {
      "$project": {
        "order_id": "$_id",
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$lookup\":{\"from\":\"customers\",\"localField\":\"customer_id\",\"foreignField\":\"_id\",\"as\":\"c\"}},{\"$unwind\":\"$c\"},{\"$match\":{\"$expr\":{\"$gt\":[{\"$subtract\":[\"$total\",\"$discount\"]},\"$c.age\"]}}},{\"$project\":{\"order_id\":\"$_id\",\"_id\":false}}])",
  "warnings": [
    {
      "message": "JOIN matches a null or missing key with null or missing keys in the other collection, which SQL never does",
      "offset": 39,
      "at": "JOIN customers c ON o.cu"
    },
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 87,
      "at": "o.total - o.discount > c"
    },
    {
      "message": "comparisons computed with $expr rank null and missing below every other value, so a null operand can satisfy < and <=",
      "offset": 87,
      "at": "o.total - o.discount > c"
    }
  ]
}
