{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "total": {
          "$gt": {
            "$numberInt": "100"
          }
        }
      }
    },
    {
      "$group": {
        "_id": {
          "status": "$status"
        }
      }
    },
    {
      "$project": {
        "status": "$_id.status",
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"total\":{\"$gt\":{\"$numberInt\":\"100\"}}}},{\"$group\":{\"_id\":{\"status\":\"$status\"}}},{\"$project\":{\"status\":\"$_id.status\",\"_id\":false}}])",
  "warnings": [
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 41,
      "at": "total > 100"
    }
  ]
}
