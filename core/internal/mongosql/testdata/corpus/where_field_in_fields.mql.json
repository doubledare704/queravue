{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "$expr": {
          "$in": [
            "$qty",
            [
              "$discount",
              {
                "$numberInt": "2"
              }
            ]
          ]
        }
      }
    },
    {
      "$project": {
        "_id": true
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"$expr\":{\"$in\":[\"$qty\",[\"$discount\",{\"$numberInt\":\"2\"}]]}}},{\"$project\":{\"_id\":true}}])",
  "warnings": [
    {
      "message": "comparisons computed with $expr rank null and missing below every other value, so a null operand can satisfy < and <=",
      "offset": 29,
      "at": "qty IN (discount, 2)"
    }
  ]
}
