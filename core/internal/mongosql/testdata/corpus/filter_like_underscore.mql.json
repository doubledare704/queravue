{
  "kind": "FIND",
  "database": "shop",
  "collection": "users",
  "filter": {
    "code": {
      "$regularExpression": {
        "pattern": "^J.n$",
        "options": "s"
      }
    }
  },
  "shell": "db.getSiblingDB(\"shop\").users.find({\"code\":{\"$regularExpression\":{\"pattern\":\"^J.n$\",\"options\":\"s\"}}})",
  "warnings": [
    {
      "message": "LIKE becomes an anchored, escaped $regex; ILIKE adds the i option",
      "offset": 26,
      "at": "code LIKE 'J_n'"
    }
  ]
}
