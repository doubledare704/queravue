{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$lookup": {
        "from": "customers",
        "let": {
          "v0": "$customer_id",
          "v1": "$qty"
        },
        "pipeline": [
          {
            "$match": {
              "$expr": {
                "$and": [
                  {
                    "$eq": [
                      "$$v0",
                      "$_id"
                    ]
                  },
                  {
                    "$gt": [
                      "$age",
                      {
                        "$multiply": [
                          "$$v1",
                          {
                            "$numberInt": "10"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ],
        "as": "c"
      }
    },
    {
      "$unwind": "$c"
    },
    {
      "$project": {
        "order_id": "$_id",
        "cid": "$c._id",
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$lookup\":{\"from\":\"customers\",\"let\":{\"v0\":\"$customer_id\",\"v1\":\"$qty\"},\"pipeline\":[{\"$match\":{\"$expr\":{\"$and\":[{\"$eq\":[\"$$v0\",\"$_id\"]},{\"$gt\":[\"$age\",{\"$multiply\":[\"$$v1\",{\"$numberInt\":\"10\"}]}]}]}}}],\"as\":\"c\"}},{\"$unwind\":\"$c\"},{\"$project\":{\"order_id\":\"$_id\",\"cid\":\"$c._id\",\"_id\":false}}])",
  "warnings": [
    {
      "message": "a JOIN with more than one ON condition becomes $lookup with let and pipeline, which older DocumentDB and Cosmos DB servers reject",
      "offset": 53,
      "at": "JOIN customers c ON o.cu"
    },
    {
      "message": "comparisons computed with $expr rank null and missing below every other value, so a null operand can satisfy < and <=",
      "offset": 73,
      "at": "o.customer_id = c._id AN"
    },
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 107,
      "at": "o.qty * 10"
    }
  ]
}
