{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$lookup": {
        "from": "customers",
        "localField": "customer_id",
        "foreignField": "_id",
        "as": "c"
      }
    },
    {
      "$unwind": "$c"
    },
    {
      "$group": {
        "_id": {
          "c_name": "$c.name"
        },
        "net": {
          "$sum": {
            "$subtract": [
              "$total",
              "$discount"
            ]
          }
        }
      }
    },
    {
      "$project": {
        "c.name": "$_id.c_name",
        "net": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$lookup\":{\"from\":\"customers\",\"localField\":\"customer_id\",\"foreignField\":\"_id\",\"as\":\"c\"}},{\"$unwind\":\"$c\"},{\"$group\":{\"_id\":{\"c_name\":\"$c.name\"},\"net\":{\"$sum\":{\"$subtract\":[\"$total\",\"$discount\"]}}}},{\"$project\":{\"c.name\":\"$_id.c_name\",\"net\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 15,
      "at": "SUM(o.total - o.discount"
    },
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 19,
      "at": "o.total - o.discount) AS"
    },
    {
      "message": "JOIN matches a null or missing key with null or missing keys in the other collection, which SQL never does",
      "offset": 62,
      "at": "JOIN customers c ON o.cu"
    }
  ]
}
