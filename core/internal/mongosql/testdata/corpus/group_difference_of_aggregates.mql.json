{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "status": "$status"
        },
        "sum_total": {
          "$sum": "$total"
        },
        "sum_discount": {
          "$sum": "$discount"
        }
      }
    },
    {
      "$addFields": {
        "net": {
          "$subtract": [
            "$sum_total",
            "$sum_discount"
          ]
        }
      }
    },
    {
      "$project": {
        "status": "$_id.status",
        "net": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":{\"status\":\"$status\"},\"sum_total\":{\"$sum\":\"$total\"},\"sum_discount\":{\"$sum\":\"$discount\"}}},{\"$addFields\":{\"net\":{\"$subtract\":[\"$sum_total\",\"$sum_discount\"]}}},{\"$project\":{\"status\":\"$_id.status\",\"net\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 15,
      "at": "SUM(total) - SUM(discoun"
    },
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 15,
      "at": "SUM(total) - SUM(discoun"
    }
  ]
}
