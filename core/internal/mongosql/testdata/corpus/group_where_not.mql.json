{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "customers",
  "pipeline": [
    {
      "$match": {
        "city": {
          "$ne": "Kyiv"
        }
      }
    },
    {
      "$group": {
        "_id": {
          "tier": "$tier"
        },
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$project": {
        "tier": "$_id.tier",
        "n": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").customers.aggregate([{\"$match\":{\"city\":{\"$ne\":\"Kyiv\"}}},{\"$group\":{\"_id\":{\"tier\":\"$tier\"},\"n\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$project\":{\"tier\":\"$_id.tier\",\"n\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "<>, NOT IN, NOT LIKE and negated conditions also match documents where the field is null or missing",
      "offset": 52,
      "at": "city = 'Kyiv' GROUP BY t"
    }
  ]
}
