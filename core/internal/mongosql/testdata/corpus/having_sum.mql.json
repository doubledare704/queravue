{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "customer_id": "$customer_id"
        },
        "spent": {
          "$sum": "$total"
        }
      }
    },
    {
      "$match": {
        "spent": {
          "$gte": {
            "$numberInt": "200"
          }
        }
      }
    },
    {
      "$project": {
        "customer_id": "$_id.customer_id",
        "spent": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":{\"customer_id\":\"$customer_id\"},\"spent\":{\"$sum\":\"$total\"}}},{\"$match\":{\"spent\":{\"$gte\":{\"$numberInt\":\"200\"}}}},{\"$project\":{\"customer_id\":\"$_id.customer_id\",\"spent\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 20,
      "at": "SUM(total) AS spent FROM"
    },
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 80,
      "at": "SUM(total) >= 200"
    }
  ]
}
