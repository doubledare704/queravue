{
  "kind": "FIND",
  "database": "shop",
  "collection": "users",
  "filter": {
    "name": {
      "$regularExpression": {
        "pattern": "^Ann$",
        "options": ""
      }
    }
  },
  "shell": "db.getSiblingDB(\"shop\").users.find({\"name\":{\"$regularExpression\":{\"pattern\":\"^Ann$\",\"options\":\"\"}}})",
  "warnings": [
    {
      "message": "LIKE becomes an anchored, escaped $regex; ILIKE adds the i option",
      "offset": 26,
      "at": "name LIKE 'Ann'"
    }
  ]
}
