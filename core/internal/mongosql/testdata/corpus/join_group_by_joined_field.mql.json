{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$lookup": {
        "from": "customers",
        "localField": "customer_id",
        "foreignField": "_id",
        "as": "c"
      }
    },
    {
      "$unwind": "$c"
    },
    {
      "$group": {
        "_id": {
          "c_city": "$c.city"
        },
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        },
        "revenue": {
          "$sum": "$total"
        }
      }
    },
    {
      "$project": {
        "city": "$_id.c_city",
        "n": true,
        "revenue": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$lookup\":{\"from\":\"customers\",\"localField\":\"customer_id\",\"foreignField\":\"_id\",\"as\":\"c\"}},{\"$unwind\":\"$c\"},{\"$group\":{\"_id\":{\"c_city\":\"$c.city\"},\"n\":{\"$sum\":{\"$numberInt\":\"1\"}},\"revenue\":{\"$sum\":\"$total\"}}},{\"$project\":{\"city\":\"$_id.c_city\",\"n\":true,\"revenue\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 38,
      "at": "SUM(o.total) AS revenue "
    },
    {
      "message": "JOIN matches a null or missing key with null or missing keys in the other collection, which SQL never does",
      "offset": 76,
      "at": "JOIN customers c ON o.cu"
    }
  ]
}
