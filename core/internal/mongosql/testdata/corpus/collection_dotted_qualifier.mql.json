{
  "kind": "FIND",
  "database": "shop",
  "collection": "fs.files",
  "filter": {
    "length": {
      "$gt": {
        "$numberInt": "0"
      }
    }
  },
  "shell": "db.getSiblingDB(\"shop\").getCollection(\"fs.files\").find({\"length\":{\"$gt\":{\"$numberInt\":\"0\"}}})",
  "warnings": [
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 29,
      "at": "fs.files.length > 0"
    }
  ]
}
