{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "$expr": {
          "$not": [
            {
              "$in": [
                {
                  "$subtract": [
                    "$total",
                    "$discount"
                  ]
                },
                [
                  {
                    "$numberInt": "60"
                  },
                  {
                    "$numberInt": "90"
                  }
                ]
              ]
            }
          ]
        }
      }
    },
    {
      "$project": {
        "_id": true
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"$expr\":{\"$not\":[{\"$in\":[{\"$subtract\":[\"$total\",\"$discount\"]},[{\"$numberInt\":\"60\"},{\"$numberInt\":\"90\"}]]}]}}},{\"$project\":{\"_id\":true}}])",
  "warnings": [
    {
      "message": "<>, NOT IN, NOT LIKE and negated conditions also match documents where the field is null or missing",
      "offset": 29,
      "at": "total - discount NOT IN "
    },
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 29,
      "at": "total - discount NOT IN "
    },
    {
      "message": "comparisons computed with $expr rank null and missing below every other value, so a null operand can satisfy < and <=",
      "offset": 29,
      "at": "total - discount NOT IN "
    }
  ]
}
