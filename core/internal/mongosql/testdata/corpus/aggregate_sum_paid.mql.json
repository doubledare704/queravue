{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "status": "paid"
      }
    },
    {
      "$group": {
        "_id": null,
        "revenue": {
          "$sum": "$total"
        }
      }
    },
    {
      "$project": {
        "revenue": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"status\":\"paid\"}},{\"$group\":{\"_id\":null,\"revenue\":{\"$sum\":\"$total\"}}},{\"$project\":{\"revenue\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "an aggregate without GROUP BY over no matching documents returns no row, where SQL returns one",
      "offset": 7,
      "at": "SUM(total) AS revenue FR"
    },
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 7,
      "at": "SUM(total) AS revenue FR"
    },
    {
      "message": "= and IN on an array field match when any element matches",
      "offset": 47,
      "at": "status = 'paid'"
    }
  ]
}
