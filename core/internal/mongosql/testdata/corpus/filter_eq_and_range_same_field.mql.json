      {
        "a": {
          "$numberInt": "1"
        }
      },
      {
        "a": {
          "$gt": {
            "$numberInt": "0"
          }
        }
      }
    ]
  },
  "shell": "db.getSiblingDB(\"shop\").t.find({\"$and\":[{\"a\":{\"$numberInt\":\"1\"}},{\"a\":{\"$gt\":{\"$numberInt\":\"0\"}}}]})",
  "warnings": [
    {
      "message": "= and IN on an array field match when any element matches",
      "offset": 22,
      "at": "a = 1 AND a > 0"
    },
    {
