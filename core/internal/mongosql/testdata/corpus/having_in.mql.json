{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "status": "$status"
        },
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$match": {
        "n": {
          "$in": [
            {
              "$numberInt": "1"
            },
            {
              "$numberInt": "2"
            }
          ]
        }
      }
    },
    {
      "$project": {
        "status": "$_id.status",
        "n": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":{\"status\":\"$status\"},\"n\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$match\":{\"n\":{\"$in\":[{\"$numberInt\":\"1\"},{\"$numberInt\":\"2\"}]}}},{\"$project\":{\"status\":\"$_id.status\",\"n\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "= and IN on an array field match when any element matches",
      "offset": 64,
      "at": "COUNT(*) IN (1, 2)"
    }
  ]
}
