{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$lookup": {
        "from": "customers",
        "let": {
          "v0": "$customer_id",
          "v1": "$total"
        },
        "pipeline": [
          {
            "$match": {
              "$expr": {
                "$and": [
                  {
                    "$eq": [
                      "$_id",
                      "$$v0"
                    ]
                  },
                  {
                    "$gt": [
                      "$$v1",
                      {
                        "$numberInt": "100"
                      }
                    ]
                  }
                ]
              }
            }
          }
        ],
        "as": "c"
      }
    },
    {
      "$unwind": "$c"
    },
    {
      "$project": {
        "order_id": "$_id",
        "customer": "$c.name",
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$lookup\":{\"from\":\"customers\",\"let\":{\"v0\":\"$customer_id\",\"v1\":\"$total\"},\"pipeline\":[{\"$match\":{\"$expr\":{\"$and\":[{\"$eq\":[\"$_id\",\"$$v0\"]},{\"$gt\":[\"$$v1\",{\"$numberInt\":\"100\"}]}]}}}],\"as\":\"c\"}},{\"$unwind\":\"$c\"},{\"$project\":{\"order_id\":\"$_id\",\"customer\":\"$c.name\",\"_id\":false}}])",
  "warnings": [
    {
      "message": "a JOIN with more than one ON condition becomes $lookup with let and pipeline, which older DocumentDB and Cosmos DB servers reject",
      "offset": 59,
      "at": "JOIN customers c ON c._i"
    },
    {
      "message": "comparisons computed with $expr rank null and missing below every other value, so a null operand can satisfy < and <=",
      "offset": 79,
      "at": "c._id = o.customer_id AN"
    }
  ]
}
