{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$lookup": {
        "from": "customers",
        "localField": "customer_id",
        "foreignField": "_id",
        "as": "c"
      }
    },
    {
      "$unwind": "$c"
    },
    {
      "$group": {
        "_id": {
          "c_city": "$c.city"
        },
        "revenue": {
          "$sum": "$total"
        }
      }
    },
    {
      "$sort": {
        "revenue": {
          "$numberInt": "-1"
        },
        "_id.c_city": {
          "$numberInt": "1"
        }
      }
    },
    {
      "$project": {
        "city": "$_id.c_city",
        "revenue": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$lookup\":{\"from\":\"customers\",\"localField\":\"customer_id\",\"foreignField\":\"_id\",\"as\":\"c\"}},{\"$unwind\":\"$c\"},{\"$group\":{\"_id\":{\"c_city\":\"$c.city\"},\"revenue\":{\"$sum\":\"$total\"}}},{\"$sort\":{\"revenue\":{\"$numberInt\":\"-1\"},\"_id.c_city\":{\"$numberInt\":\"1\"}}},{\"$project\":{\"city\":\"$_id.c_city\",\"revenue\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 23,
      "at": "SUM(o.total) AS revenue "
    },
    {
      "message": "JOIN matches a null or missing key with null or missing keys in the other collection, which SQL never does",
      "offset": 61,
      "at": "JOIN customers c ON o.cu"
    },
    {
      "message": "ORDER BY sorts null and missing values first in ascending order and last in descending order",
      "offset": 128,
      "at": "revenue DESC, city"
    }
  ]
}
