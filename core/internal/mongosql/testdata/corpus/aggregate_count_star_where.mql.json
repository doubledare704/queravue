{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "status": "paid"
      }
    },
    {
      "$group": {
        "_id": null,
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$project": {
        "n": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"status\":\"paid\"}},{\"$group\":{\"_id\":null,\"n\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$project\":{\"n\":true,\"_id\":false}}])",
  "warnings": [
