{
  "kind": "FIND",
  "database": "shop",
  "collection": "users",
  "filter": {
    "age": {
      "$lte": {
        "$numberInt": "30"
      }
    }
  },
  "shell": "db.getSiblingDB(\"shop\").users.find({\"age\":{\"$lte\":{\"$numberInt\":\"30\"}}})",
  "warnings": [
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 30,
      "at": "age > 30"
    }
  ]
}
