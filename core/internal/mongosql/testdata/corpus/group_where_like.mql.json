{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "customers",
  "pipeline": [
    {
      "$match": {
        "$or": [
          {
            "name": {
              "$regularExpression": {
                "pattern": "^A",
                "options": ""
              }
            }
          },
          {
            "name": {
              "$regularExpression": {
                "pattern": "e$",
                "options": ""
              }
            }
          }
        ]
      }
    },
    {
      "$group": {
        "_id": {
          "tier": "$tier"
        },
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$project": {
        "tier": "$_id.tier",
        "n": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").customers.aggregate([{\"$match\":{\"$or\":[{\"name\":{\"$regularExpression\":{\"pattern\":\"^A\",\"options\":\"\"}}},{\"name\":{\"$regularExpression\":{\"pattern\":\"e$\",\"options\":\"\"}}}]}},{\"$group\":{\"_id\":{\"tier\":\"$tier\"},\"n\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$project\":{\"tier\":\"$_id.tier\",\"n\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "LIKE becomes an anchored, escaped $regex; ILIKE adds the i option",
      "offset": 48,
      "at": "name LIKE 'A%' OR name L"
    }
  ]
}
