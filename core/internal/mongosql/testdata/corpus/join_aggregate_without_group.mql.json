{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$lookup": {
        "from": "customers",
        "localField": "customer_id",
        "foreignField": "_id",
        "as": "c"
      }
    },
    {
      "$unwind": "$c"
    },
    {
      "$match": {
        "c.tier": "gold"
      }
    },
    {
      "$group": {
        "_id": null,
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        },
        "revenue": {
          "$sum": "$total"
        }
      }
    },
    {
      "$project": {
        "n": true,
        "revenue": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$lookup\":{\"from\":\"customers\",\"localField\":\"customer_id\",\"foreignField\":\"_id\",\"as\":\"c\"}},{\"$unwind\":\"$c\"},{\"$match\":{\"c.tier\":\"gold\"}},{\"$group\":{\"_id\":null,\"n\":{\"$sum\":{\"$numberInt\":\"1\"}},\"revenue\":{\"$sum\":\"$total\"}}},{\"$project\":{\"n\":true,\"revenue\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "an aggregate without GROUP BY over no matching documents returns no row, where SQL returns one",
      "offset": 7,
      "at": "COUNT(*) AS n, SUM(o.tot"
    },
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 22,
      "at": "SUM(o.total) AS revenue "
    },
    {
      "message": "JOIN matches a null or missing key with null or missing keys in the other collection, which SQL never does",
      "offset": 60,
      "at": "JOIN customers c ON o.cu"
    },
    {
      "message": "= and IN on an array field match when any element matches",
      "offset": 108,
      "at": "c.tier = 'gold'"
    }
  ]
}
