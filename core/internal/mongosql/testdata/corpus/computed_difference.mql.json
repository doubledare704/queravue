{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$addFields": {
        "net": {
          "$subtract": [
            "$total",
            "$discount"
          ]
        }
      }
    },
    {
      "$project": {
        "_id": true,
        "net": true
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$addFields\":{\"net\":{\"$subtract\":[\"$total\",\"$discount\"]}}},{\"$project\":{\"_id\":true,\"net\":true}}])",
  "warnings": [
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 12,
      "at": "total - discount AS net "
    }
  ]
}
