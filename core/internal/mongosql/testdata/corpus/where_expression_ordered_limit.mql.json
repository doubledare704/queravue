{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "$expr": {
          "$gt": [
            "$total",
            {
              "$multiply": [
                "$discount",
                {
                  "$numberInt": "10"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "$sort": {
        "_id": {
          "$numberInt": "1"
        }
      }
    },
    {
      "$project": {
        "_id": true
      }
    },
    {
      "$limit": {
        "$numberLong": "4"
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"$expr\":{\"$gt\":[\"$total\",{\"$multiply\":[\"$discount\",{\"$numberInt\":\"10\"}]}]}}},{\"$sort\":{\"_id\":{\"$numberInt\":\"1\"}}},{\"$project\":{\"_id\":true}},{\"$limit\":{\"$numberLong\":\"4\"}}])",
  "warnings": [
    {
      "message": "comparisons computed with $expr rank null and missing below every other value, so a null operand can satisfy < and <=",
      "offset": 29,
      "at": "total > discount * 10 OR"
    },
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 37,
      "at": "discount * 10 ORDER BY _"
    },
    {
      "message": "ORDER BY sorts null and missing values first in ascending order and last in descending order",
      "offset": 60,
      "at": "_id LIMIT 4"
    }
  ]
}
