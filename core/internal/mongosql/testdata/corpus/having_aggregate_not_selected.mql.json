{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "status": "$status"
        },
        "max_total": {
          "$max": "$total"
        }
      }
    },
    {
      "$match": {
        "max_total": {
          "$gt": {
            "$numberInt": "250"
          }
        }
      }
    },
    {
      "$project": {
        "status": "$_id.status",
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":{\"status\":\"$status\"},\"max_total\":{\"$max\":\"$total\"}}},{\"$match\":{\"max_total\":{\"$gt\":{\"$numberInt\":\"250\"}}}},{\"$project\":{\"status\":\"$_id.status\",\"_id\":false}}])",
  "warnings": [
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 49,
      "at": "MAX(total) > 250"
    }
  ]
}
