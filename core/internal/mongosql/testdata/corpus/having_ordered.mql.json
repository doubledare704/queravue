{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "status": "$status"
        },
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$match": {
        "n": {
          "$gte": {
            "$numberInt": "2"
          }
        }
      }
    },
    {
      "$sort": {
        "n": {
          "$numberInt": "-1"
        },
        "_id.status": {
          "$numberInt": "1"
        }
      }
    },
    {
      "$project": {
        "status": "$_id.status",
        "n": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":{\"status\":\"$status\"},\"n\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$match\":{\"n\":{\"$gte\":{\"$numberInt\":\"2\"}}}},{\"$sort\":{\"n\":{\"$numberInt\":\"-1\"},\"_id.status\":{\"$numberInt\":\"1\"}}},{\"$project\":{\"status\":\"$_id.status\",\"n\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 64,
      "at": "COUNT(*) >= 2 ORDER BY n"
    },
    {
      "message": "ORDER BY sorts null and missing values first in ascending order and last in descending order",
      "offset": 87,
      "at": "n DESC, status"
    }
  ]
}
