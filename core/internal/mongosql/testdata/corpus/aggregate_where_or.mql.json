{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "$or": [
          {
            "status": "paid"
          },
          {
            "total": {
              "$gt": {
                "$numberInt": "150"
              }
            }
          }
        ]
      }
    },
    {
      "$group": {
        "_id": null,
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$project": {
        "n": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"$or\":[{\"status\":\"paid\"},{\"total\":{\"$gt\":{\"$numberInt\":\"150\"}}}]}},{\"$group\":{\"_id\":null,\"n\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$project\":{\"n\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "an aggregate without GROUP BY over no matching documents returns no row, where SQL returns one",
      "offset": 7,
      "at": "COUNT(*) AS n FROM order"
    },
    {
      "message": "= and IN on an array field match when any element matches",
      "offset": 39,
      "at": "status = 'paid' OR total"
    },
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 58,
      "at": "total > 150"
    }
  ]
}
