{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$addFields": {
        "negated": {
          "$multiply": [
            "$total",
            {
              "$numberInt": "-1"
            }
          ]
        }
      }
    },
    {
      "$project": {
        "_id": true,
        "negated": true
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$addFields\":{\"negated\":{\"$multiply\":[\"$total\",{\"$numberInt\":\"-1\"}]}}},{\"$project\":{\"_id\":true,\"negated\":true}}])",
  "warnings": [
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 12,
      "at": "total * -1 AS negated FR"
    }
  ]
}
