{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "status": "$status"
        },
        "mean": {
          "$avg": "$total"
        }
      }
    },
    {
      "$match": {
        "mean": {
          "$gte": {
            "$numberInt": "50"
          },
          "$lte": {
            "$numberInt": "150"
          }
        }
      }
    },
    {
      "$project": {
        "status": "$_id.status",
        "mean": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":{\"status\":\"$status\"},\"mean\":{\"$avg\":\"$total\"}}},{\"$match\":{\"mean\":{\"$gte\":{\"$numberInt\":\"50\"},\"$lte\":{\"$numberInt\":\"150\"}}}},{\"$project\":{\"status\":\"$_id.status\",\"mean\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 69,
      "at": "AVG(total) BETWEEN 50 AN"
    }
  ]
}
