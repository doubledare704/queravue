{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$lookup": {
        "from": "customers",
        "localField": "customer_id",
        "foreignField": "_id",
        "as": "c"
      }
    },
    {
      "$unwind": {
        "path": "$c",
        "preserveNullAndEmptyArrays": true
      }
    },
    {
      "$match": {
        "c.name": null
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$lookup\":{\"from\":\"customers\",\"localField\":\"customer_id\",\"foreignField\":\"_id\",\"as\":\"c\"}},{\"$unwind\":{\"path\":\"$c\",\"preserveNullAndEmptyArrays\":true}},{\"$match\":{\"c.name\":null}}])",
  "warnings": [
    {
      "message": "JOIN matches a null or missing key with null or missing keys in the other collection, which SQL never does",
      "offset": 23,
      "at": "LEFT JOIN customers c ON"
    },
    {
      "message": "IS NULL also matches documents where the field is missing",
      "offset": 76,
      "at": "c.name IS NULL"
    }
  ]
}
