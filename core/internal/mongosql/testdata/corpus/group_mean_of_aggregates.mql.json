{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "status": "$status"
        },
        "sum_total": {
          "$sum": "$total"
        },
        "count": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$addFields": {
        "mean": {
          "$divide": [
            {
              "$multiply": [
                "$sum_total",
                {
                  "$numberDouble": "1.0"
                }
              ]
            },
            "$count"
          ]
        }
      }
    },
    {
      "$project": {
        "status": "$_id.status",
        "mean": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":{\"status\":\"$status\"},\"sum_total\":{\"$sum\":\"$total\"},\"count\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$addFields\":{\"mean\":{\"$divide\":[{\"$multiply\":[\"$sum_total\",{\"$numberDouble\":\"1.0\"}]},\"$count\"]}}},{\"$project\":{\"status\":\"$_id.status\",\"mean\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 15,
      "at": "SUM(total) * 1.0 / COUNT"
    },
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 15,
      "at": "SUM(total) * 1.0 / COUNT"
    }
  ]
}
