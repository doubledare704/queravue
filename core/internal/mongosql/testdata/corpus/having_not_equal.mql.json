{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "status": "$status"
        },
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$match": {
        "n": {
          "$ne": {
            "$numberInt": "4"
          }
        }
      }
    },
    {
      "$project": {
        "status": "$_id.status",
        "n": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":{\"status\":\"$status\"},\"n\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$match\":{\"n\":{\"$ne\":{\"$numberInt\":\"4\"}}}},{\"$project\":{\"status\":\"$_id.status\",\"n\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "<>, NOT IN, NOT LIKE and negated conditions also match documents where the field is null or missing",
      "offset": 64,
      "at": "COUNT(*) <> 4"
    }
  ]
}
