{
  "kind": "FIND",
  "database": "shop",
  "collection": "users",
  "filter": {
    "age": {
      "$gte": {
        "$numberInt": "18"
      }
    }
  },
  "shell": "db.getSiblingDB(\"shop\").users.find({\"age\":{\"$gte\":{\"$numberInt\":\"18\"}}})",
  "warnings": [
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 60,
      "at": "age >= 18 -- adults"
    }
  ]
}
