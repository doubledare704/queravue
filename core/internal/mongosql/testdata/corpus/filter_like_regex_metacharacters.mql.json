{
  "kind": "FIND",
  "database": "shop",
  "collection": "files",
  "filter": {
    "name": {
      "$regularExpression": {
        "pattern": "^a\\.b\\+\\(c\\)",
        "options": ""
      }
    }
  },
  "shell": "db.getSiblingDB(\"shop\").files.find({\"name\":{\"$regularExpression\":{\"pattern\":\"^a\\\\.b\\\\+\\\\(c\\\\)\",\"options\":\"\"}}})",
  "warnings": [
    {
      "message": "LIKE becomes an anchored, escaped $regex; ILIKE adds the i option",
      "offset": 26,
      "at": "name LIKE 'a.b+(c)%'"
    }
  ]
}
