{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$group": {
        "_id": null,
        "n": {
          "$sum": {
            "$numberInt": "1"
          }
        }
      }
    },
    {
      "$match": {
        "n": {
          "$gt": {
            "$numberInt": "10"
          }
        }
      }
    },
    {
      "$project": {
        "n": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$group\":{\"_id\":null,\"n\":{\"$sum\":{\"$numberInt\":\"1\"}}}},{\"$match\":{\"n\":{\"$gt\":{\"$numberInt\":\"10\"}}}},{\"$project\":{\"n\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "an aggregate without GROUP BY over no matching documents returns no row, where SQL returns one",
      "offset": 7,
      "at": "COUNT(*) AS n FROM order"
    },
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 40,
      "at": "COUNT(*) > 10"
    }
  ]
}
