{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "customers",
  "pipeline": [
    {
      "$group": {
        "_id": {
          "city": "$city"
        }
      }
    },
    {
      "$project": {
        "city": "$_id.city",
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").customers.aggregate([{\"$group\":{\"_id\":{\"city\":\"$city\"}}},{\"$project\":{\"city\":\"$_id.city\",\"_id\":false}}])"
}
