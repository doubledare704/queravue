{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "status": "paid"
      }
    },
    {
      "$group": {
        "_id": {
          "customer_id": "$customer_id"
        },
        "spent": {
          "$sum": "$total"
        }
      }
    },
    {
      "$match": {
        "spent": {
          "$gt": {
            "$numberInt": "100"
          }
        }
      }
    },
    {
      "$project": {
        "customer_id": "$_id.customer_id",
        "spent": true,
        "_id": false
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"status\":\"paid\"}},{\"$group\":{\"_id\":{\"customer_id\":\"$customer_id\"},\"spent\":{\"$sum\":\"$total\"}}},{\"$match\":{\"spent\":{\"$gt\":{\"$numberInt\":\"100\"}}}},{\"$project\":{\"customer_id\":\"$_id.customer_id\",\"spent\":true,\"_id\":false}}])",
  "warnings": [
    {
      "message": "SUM of no numeric values is 0, where SQL returns NULL",
      "offset": 20,
      "at": "SUM(total) AS spent FROM"
    },
    {
      "message": "= and IN on an array field match when any element matches",
      "offset": 58,
      "at": "status = 'paid' GROUP BY"
    },
    {
      "message": "range comparisons only match values of the same BSON type: age > 30 skips the string \"40\"",
      "offset": 102,
      "at": "SUM(total) > 100"
    }
  ]
}
