{
  "kind": "AGGREGATE",
  "database": "shop",
  "collection": "orders",
  "pipeline": [
    {
      "$match": {
        "$expr": {
          "$and": [
            {
              "$gte": [
                "$total",
                "$discount"
              ]
            },
            {
              "$lte": [
                "$total",
                {
                  "$multiply": [
                    "$qty",
                    {
                      "$numberInt": "100"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "$project": {
        "_id": true
      }
    }
  ],
  "shell": "db.getSiblingDB(\"shop\").orders.aggregate([{\"$match\":{\"$expr\":{\"$and\":[{\"$gte\":[\"$total\",\"$discount\"]},{\"$lte\":[\"$total\",{\"$multiply\":[\"$qty\",{\"$numberInt\":\"100\"}]}]}]}}},{\"$project\":{\"_id\":true}}])",
  "warnings": [
    {
      "message": "comparisons computed with $expr rank null and missing below every other value, so a null operand can satisfy < and <=",
      "offset": 29,
      "at": "total BETWEEN discount A"
    },
    {
      "message": "+ - * / run as $add, $subtract, $multiply and $divide: operands must be numbers, a null or missing operand gives null, and / always returns a double",
      "offset": 56,
      "at": "qty * 100"
    }
  ]
}
